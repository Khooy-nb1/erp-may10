# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# PGPORT must match the host port published by docker-compose.yml: it defaults to 5432,
# and is overridden by the POSTGRES_HOST_PORT variable at `docker compose up` time
# (e.g. on a machine that already runs a native PostgreSQL on 5432, use 55432).
PGHOST=localhost
PGPORT=5432
PGDATABASE=erp_sales_crm_dev
PGUSER=postgres
# Example files never carry a real credential. For the disposable local dev database the value is
# `postgres_dev_password` (see docker-compose.yml and the local runbook); set it in the gitignored
# backend/.env, never here.
PGPASSWORD=your_password_here
PGSSL=false

# Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=8h

# Business Policy Configurations (Injected / Configurable)
# Tax Policy: fixed rate as decimal (e.g. 0.08 for 8%, 0.10 for 10%), or 0 for no tax
TAX_RATE=0
# Credit Limit Mode: "warning" or "hard_block"
CREDIT_LIMIT_MODE=warning
