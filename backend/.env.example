# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=erp_sales_crm_dev
PGUSER=postgres
PGPASSWORD=your_password_here
PGSSL=false

# Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=8h

# Business Policy Configurations (Injected / Configurable)
# Tax Policy: fixed rate as decimal (e.g. 0.08 for 8%, 0.10 for 10%), or 0 for no tax
TAX_RATE=0
# Credit Limit Mode: "warning" or "hard_block"
CREDIT_LIMIT_MODE=warning
